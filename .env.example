# Required: DeepSeek API key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Disable LangSmith cloud tracing for local development
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Optional: use Jina Reader instead of the bounded local webpage extractor
# JINA_API_KEY=jina_xxxxxxxxxxxxxxxxx

# Fine-tuned rumor classifier service. For the course model, create an SSH
# tunnel on host port 18000 and keep the remote model port private.
RUMOR_MODEL_BASE_URL=http://host.docker.internal:18000
RUMOR_MODEL_API_STYLE=modelscope_chat
RUMOR_MODEL_NAME=congyang/fine-tuned-qwen-2.5-3b-instruct-based-on-rumor-datasets
RUMOR_MODEL_TIMEOUT_SECONDS=20
RUMOR_CLASSIFIER_REQUIRED=true
RUMOR_TIMELINE_ENABLED=false
# RUMOR_MODEL_API_KEY=only_if_the_service_requires_one

# Course-aligned local vector RAG. Build the index explicitly before use.
RUMOR_RAG_ENABLED=true
RUMOR_RAG_EMBEDDING_MODEL=GanymedeNil/text2vec-large-chinese
RUMOR_RAG_DEVICE=cpu
RUMOR_RAG_PERSIST_DIR=/data/rumorbuster/rag
RUMOR_RAG_TIMEOUT_SECONDS=20
HF_HOME=/data/huggingface
