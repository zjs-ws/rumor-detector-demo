# Required: DeepSeek API key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Disable LangSmith cloud tracing for local development
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Optional: fine-tuned rumor classifier service
# When the service runs on the Docker host:
# RUMOR_MODEL_BASE_URL=http://host.docker.internal:8000/v1
