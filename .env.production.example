# Public deployment parameter. Only Nginx publishes a host port.
RUMORBUSTER_HTTP_PORT=8080

# Internal service addresses used by Gateway and optional integrations.
LANGGRAPH_INTERNAL_URL=http://langgraph:2024
RUMOR_AGENT_GRAPH_ID=rumor_agent
RUMOR_CHECK_TIMEOUT_SECONDS=120

# Primary model configuration referenced by config.yaml.
# Keep the real secret only in .env.production on the server.
DEEPSEEK_API_KEY=

# Fine-tuned classifier reached through a local SSH tunnel. The model port
# remains bound to 127.0.0.1 on the GPU host and is never exposed publicly.
RUMOR_MODEL_BASE_URL=http://host.docker.internal:18000
RUMOR_MODEL_API_KEY=
RUMOR_MODEL_API_STYLE=modelscope_chat
RUMOR_MODEL_NAME=congyang/fine-tuned-qwen-2.5-3b-instruct-based-on-rumor-datasets
RUMOR_MODEL_TIMEOUT_SECONDS=20
RUMOR_CLASSIFIER_REQUIRED=true
