# Optional local overrides for scripts/claude-deepseek.sh.
# Copy this file to .claude/deepseek.env only if you do not want to reuse the
# DEEPSEEK_API_KEY already stored in the repository root .env file.

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_CLAUDE_PRIMARY_MODEL=deepseek-v4-pro[1m]
DEEPSEEK_CLAUDE_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_CLAUDE_EFFORT=max
